menu "Geiger Counter"

    config GEIGER_DEVICE_NAME
        string "Device name"
        default "Geiger Counter"
        help
            Shown in the web UI and used as the Home Assistant device name.
            Can be changed at runtime, the value here is only the default.

    menu "Wi-Fi provisioning"

        config GEIGER_AP_SSID_PREFIX
            string "SoftAP SSID prefix"
            default "esp32"
            help
                The advertised SSID is this prefix followed by the last three
                bytes of the station MAC address.

        config GEIGER_AP_PASSWORD
            string "SoftAP password"
            default ""
            help
                At least 8 characters to enable WPA2, or empty for an open network.

        config GEIGER_AP_CHANNEL
            int "SoftAP channel"
            range 1 13
            default 1

        config GEIGER_AP_MAX_CONN
            int "SoftAP maximum connections"
            range 1 10
            default 4

        config GEIGER_AP_IP
            string "SoftAP IPv4 address"
            default "192.168.4.1"
            help
                Address the captive portal redirects to. Must match the DHCP
                server configured for the AP netif.

        config GEIGER_STA_MAX_RETRY
            int "Station connection retries"
            range 1 20
            default 5

        config GEIGER_PORTAL_LINGER_MS
            int "SoftAP linger time after the station connects (ms)"
            default 60000
            help
                Set to 0 to keep the SoftAP running forever.

    endmenu

    menu "Web UI"

        config GEIGER_MDNS_HOSTNAME
            string "mDNS hostname"
            default "geigercounter"
            help
                The device is reachable as <hostname>.local.

        config GEIGER_MDNS_INSTANCE
            string "mDNS instance name"
            default "Geiger Counter"

        config GEIGER_HTTP_PORT
            int "HTTP server port"
            range 1 65535
            default 80

    endmenu

    menu "MQTT / Home Assistant"

        comment "Defaults only, every value can be changed from the web UI"

        config GEIGER_MQTT_ENABLED
            bool "Enable MQTT by default"
            default n

        config GEIGER_MQTT_URI
            string "Broker URI"
            default "mqtt://homeassistant.local:1883"
            help
                mqtt://host:port, mqtts://host:port or ws://host:port/path.

        config GEIGER_MQTT_USER
            string "Broker username"
            default ""

        config GEIGER_MQTT_PASS
            string "Broker password"
            default ""

        config GEIGER_MQTT_TOPIC
            string "Base topic"
            default "geiger"
            help
                Topics are <base>/<device-id>/state and <base>/<device-id>/status.

        config GEIGER_MQTT_HA_DISCOVERY
            bool "Publish Home Assistant discovery"
            default y

        config GEIGER_MQTT_HA_PREFIX
            string "Home Assistant discovery prefix"
            default "homeassistant"

        config GEIGER_MQTT_INTERVAL_S
            int "State publish interval (s)"
            range 1 3600
            default 30

    endmenu

endmenu
